# Copy this to .env and edit. Everything here is optional — with no .env at all
# the bundled example scenarios still run.
#
# ⚠ NEVER commit .env, or any copy of it. It holds an API token, and a token in
#   a commit is compromised even if you delete it afterwards. .gitignore covers
#   .env and every variant (".env copy", ".env.local", .env.bak…); this example
#   is the one file allow-listed back in.
#
# The GUI writes this file too (⚙ Settings), so it is kept comment- and
# order-preserving: hand edits and UI edits live together fine.

# --- Bot profiles -----------------------------------------------------------
# Each profile is a host path holding your bot's flat .js modules, mounted
# read-only at /bots/<name>. A scenario picks one in its settings.json:
#
#     { "bot": "speedrun" }
#
# Registering them up front is what makes switching free: a bind mount is fixed
# when the container is created, so the container cannot read a path it has
# never been given. Adding or changing a PATH is therefore a mount change —
# save, then press "Apply mount changes" in Settings (or run `npm run ui`).
# Changing which profile is the DEFAULT is instant.
#
# Names are lowercase letters, digits and underscore. No hyphen: the name
# becomes part of the variable name, and .env keys cannot contain one.
DOJO_BOT_PROFILE_DEFAULT_PATH=C:/path/to/your/screeps/scripts
# DOJO_BOT_PROFILE_SPEEDRUN_PATH=C:/path/to/another/bot
# DOJO_DEFAULT_BOT_PROFILE=default

# Legacy equivalent of DOJO_BOT_PROFILE_DEFAULT_PATH. Still honoured: the server
# rewrites it into the profile form on boot, keeping a .env.bak beside it.
# DOJO_BOT_PATH=C:/path/to/your/screeps/scripts

# GUI server port (npm run ui). Published only to host loopback (127.0.0.1).
DOJO_UI_PORT=8787

# Accelerated Screeps MOCK engine. All optimizations are enabled by default.
# Set the master to 0 for stock multiprocess behavior, or override individual
# features with explicit 0/1 values (an unset individual inherits the master).
DOJO_FAST_MOCK_ENGINE=1
# DOJO_FAST_MOCK_ENGINE_RPC_V8=1
# DOJO_FAST_MOCK_ENGINE_CODE_CACHE=1
# DOJO_FAST_MOCK_ENGINE_ROOM_GUARD=1
# DOJO_FAST_MOCK_ENGINE_IN_PROCESS=1
# DOJO_FAST_MOCK_ENGINE_RESET_ACTIVE_ROOMS=1

# --- Screeps server profiles (room import) ----------------------------------
# shard0..shard3, shardx and season are CREATED FOR YOU on first boot, prefilled
# except for the credentials. DOJO_SCREEPS_PROFILES_SEEDED records that it
# happened, so if you delete or rename one it stays that way. What follows is
# what you get, for reference and for hand editing.
#
# A scenario picks one in its settings.json:
#
#     { "server": "season" }
#
# Each profile STANDS ALONE. It inherits nothing from another profile: a key you
# leave out falls back to the built-in default (screeps.com, 443, https, /,
# shard0) and nowhere else.
#
# AUTH is either/or. Set TOKEN, or set USERNAME (or EMAIL) + PASSWORD — the
# second form is for a private server whose token is accepted over REST but
# rejected by the WebSocket (e.g. screepsmod-auth). Setting both wastes one.
#
# HOSTNAME / PORT / PROTOCOL / PATH describe WHERE the server is and apply to
# either auth method.

# DOJO_SCREEPS_PROFILE_SHARD0_TOKEN=
DOJO_SCREEPS_PROFILE_SHARD0_HOSTNAME=screeps.com
DOJO_SCREEPS_PROFILE_SHARD0_PORT=443
DOJO_SCREEPS_PROFILE_SHARD0_PROTOCOL=https
DOJO_SCREEPS_PROFILE_SHARD0_PATH=/
DOJO_SCREEPS_PROFILE_SHARD0_SHARD=shard0
# ...and the same again for shard1, shard2 and shard3.

# The seasonal server is the same host under its own path.
DOJO_SCREEPS_PROFILE_SEASON_HOSTNAME=screeps.com
DOJO_SCREEPS_PROFILE_SEASON_PORT=443
DOJO_SCREEPS_PROFILE_SEASON_PROTOCOL=https
DOJO_SCREEPS_PROFILE_SEASON_PATH=/season/
DOJO_SCREEPS_PROFILE_SEASON_SHARD=shardSeason

# "shardx" is seeded as the one to edit for a private server, or a shard with no
# row of its own:
# DOJO_SCREEPS_PROFILE_SHARDX_HOSTNAME=localhost
# DOJO_SCREEPS_PROFILE_SHARDX_PORT=21025
# DOJO_SCREEPS_PROFILE_SHARDX_PROTOCOL=http
# DOJO_SCREEPS_PROFILE_SHARDX_USERNAME=me
# DOJO_SCREEPS_PROFILE_SHARDX_PASSWORD=secret

# Which profile a scenario gets when it names none.
DOJO_DEFAULT_SCREEPS_PROFILE=shard0

# Written by the server the first time it seeds the profiles above. Leave it
# alone unless you want them created again.
# DOJO_SCREEPS_PROFILES_SEEDED=1

# Legacy unsuffixed keys. Still honoured: the server rewrites them into a
# profile on boot — named "a_server", since "default" named the fallback rather
# than the server — keeping a .env.bak beside it.
# DOJO_SCREEPS_TOKEN=
# DOJO_SCREEPS_HOSTNAME=screeps.com
# DOJO_SCREEPS_SHARD=shard0
