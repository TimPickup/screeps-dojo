# --- Bot profiles -----------------------------------------------------------
# Each profile is a host path holding your bot's flat .js modules. Every one is
# mounted read-only at /bots/<name>, so a scenario can pick between them with no
# container restart (scenarios/<name>/settings.json -> { "bot": "speedrun" }).
#
# Adding or changing a PATH is a mount change: run `npm run ui` once afterwards.
# Changing which profile is the default is free.
DOJO_BOT_PROFILE_DEFAULT_PATH=C:/path/to/your/screeps/scripts
# DOJO_BOT_PROFILE_SPEEDRUN_PATH=C:/path/to/another/bot
# DOJO_DEFAULT_BOT_PROFILE=default

# Legacy equivalent of DOJO_BOT_PROFILE_DEFAULT_PATH — still honoured.
# DOJO_BOT_PATH=C:/path/to/your/screeps/scripts

# GUI server port (npm run ui). Published only to host loopback (127.0.0.1).
DOJO_UI_PORT=8787

# Accelerated Screeps MOCK engine. All optimizations are enabled by default.
# Set the master to 0 for stock multiprocess behavior, or override individual
# features with explicit 0/1 values (an unset individual inherits the master).
DOJO_FAST_MOCK_ENGINE=1
# DOJO_FAST_MOCK_ENGINE_RPC_V8=1
# DOJO_FAST_MOCK_ENGINE_CODE_CACHE=1
# DOJO_FAST_MOCK_ENGINE_ROOM_GUARD=1
# DOJO_FAST_MOCK_ENGINE_IN_PROCESS=1
# DOJO_FAST_MOCK_ENGINE_RESET_ACTIVE_ROOMS=1

# --- Screeps server profiles (npm run import-room) ---------------------------
# A scenario picks one with settings.json -> { "server": "season" }.
#
# Each profile STANDS ALONE: it inherits nothing from any other profile. A key
# you leave out falls back to the built-in default shown below, never to another
# profile's value.
#
# AUTH is either/or. Set TOKEN, or set USERNAME (or EMAIL) + PASSWORD — the
# second form is for a private server whose token is accepted over REST but
# rejected by the WebSocket (e.g. screepsmod-auth). Setting both wastes one.
#
# HOSTNAME / PORT / PROTOCOL / PATH describe WHERE the server is and apply to
# either auth method. Defaults: screeps.com, 443, https, /  — a typical private
# server is localhost, 21025, http, / instead.
DOJO_SCREEPS_PROFILE_DEFAULT_TOKEN=
DOJO_SCREEPS_PROFILE_DEFAULT_HOSTNAME=screeps.com
DOJO_SCREEPS_PROFILE_DEFAULT_PATH=/
DOJO_SCREEPS_PROFILE_DEFAULT_PORT=443
DOJO_SCREEPS_PROFILE_DEFAULT_PROTOCOL=https
DOJO_SCREEPS_PROFILE_DEFAULT_SHARD=shard0
# DOJO_SCREEPS_PROFILE_DEFAULT_USERNAME=
# DOJO_SCREEPS_PROFILE_DEFAULT_PASSWORD=

# Same server, the seasonal shard — one key is enough.
# DOJO_SCREEPS_PROFILE_SEASON_SHARD=season

# A private server.
# DOJO_SCREEPS_PROFILE_LOCAL_HOSTNAME=localhost
# DOJO_SCREEPS_PROFILE_LOCAL_PORT=21025
# DOJO_SCREEPS_PROFILE_LOCAL_PROTOCOL=http
# DOJO_SCREEPS_PROFILE_LOCAL_USERNAME=me
# DOJO_SCREEPS_PROFILE_LOCAL_PASSWORD=secret

# DOJO_DEFAULT_SCREEPS_PROFILE=default

# Legacy unsuffixed keys — still honoured, and map to the "default" profile.
# DOJO_SCREEPS_TOKEN=
# DOJO_SCREEPS_HOSTNAME=screeps.com
# DOJO_SCREEPS_SHARD=shard0
