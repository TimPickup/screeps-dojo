{
	"name": "screeps-dojo",
	"version": "0.7.0",
	"description": "Scenario test harness for Screeps bots: real engine, tick by tick, headless",
	"private": true,
	"license": "MIT",
	"scripts": {
		"postinstall": "node tools/mockEnginePatches.cjs apply",
		"verify:mock-engine-patches": "node tools/mockEnginePatches.cjs check",
		"build": "docker compose build",
		"bots:sync": "node scripts/composeOverride.js",
		"clean": "node scripts/clean.js",
		"update": "node scripts/update.js",
		"import-room": "docker compose run --rm dojo node scripts/importRoom.js",
		"install:dojo": "docker compose run --rm dojo npm install",
		"smoke": "docker compose run --rm dojo npm run smoke:inner",
		"smoke:inner": "node scripts/smoke.js",
		"render": "node scripts/render.js",
		"test": "node scripts/test.js",
		"test:internal": "node scripts/test.js --suite internal",
		"test:unit": "node scripts/test.js --suite unit",
		"test:integration": "node scripts/test.js --suite integration",
		"test:scenarios": "node scripts/test.js --suite scenarios",
		"test:ui": "npm --prefix ui test",
		"serve:inner": "node scripts/serve.js",
		"build:ui": "cd ui && npm install && npm run build",
		"ui": "node scripts/ui.js",
		"ui:stop": "node scripts/hostAgent.js --stop && docker compose stop ui",
		"ui:down": "node scripts/hostAgent.js --stop && docker compose down",
		"host-agent": "node scripts/hostAgent.js"
	},
	"dependencies": {
		"@napi-rs/canvas": "1.0.3",
		"ffmpeg-static": "5.3.0",
		"screeps": "4.3.0",
		"screeps-api": "2.0.1",
		"screeps-server-mockup": "github:screepers/screeps-server-mockup#703645f408dbe770cbe8cb640c5ed8995f5e1c44"
	},
	"devDependencies": {
		"mocha": "^11.0.0"
	}
}
